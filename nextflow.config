// Nextflow configuration file
// Ravi Pandey — RNA-seq Pipeline on AWS

// Default parameters
params {
    bucket          = "ravi-pandey-bioinformatics"
    counts_file     = "rnaseq/results/counts/5XFAD_counts.txt"
    outdir          = "rnaseq/results/nextflow"
    condition_ad    = "3xTgAD"
    condition_wt    = "WT"
    pval_cutoff     = 0.05
    lfc_cutoff      = 0.5
}

// Execution profiles
profiles {

    // Local execution (for testing)
    local {
        process.executor = 'local'
        process.memory   = '6 GB'
        process.cpus     = 2
    }

    // AWS Batch execution (for production)
    aws {
        process.executor = 'awsbatch'
        process.queue    = 'ravi-batch-queue'
        aws.region       = 'us-east-1'
        aws.batch.cliPath = '/usr/local/bin/aws'
        workDir          = "s3://${params.bucket}/nextflow/work"
    }
}

// Enable reports
report {
    enabled = true
    file    = "${params.outdir}/reports/pipeline_report.html"
}

timeline {
    enabled = true
    file    = "${params.outdir}/reports/timeline.html"
}

// Resource defaults
process {
    errorStrategy = 'retry'
    maxRetries    = 3
}
